# Copy to .env and fill in. Used by docker-compose.yml.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
WEB_PORT=8090

# Add your domain(s) when deploying, e.g. stayhaven.com,www.stayhaven.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8090,http://127.0.0.1:8090
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8090

DB_NAME=spotyourstay
DB_USER=spot
DB_PASSWORD=change-me

# Created automatically on first start if both are set.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=admin@example.com

# WhatsApp OTP login (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
